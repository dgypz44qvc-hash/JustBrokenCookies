    background-size: 28px 8px, 28px 8px !important;
    background-position:
      14px var(--jbc-film-dot-gap-final),
      14px calc(100% - var(--jbc-film-dot-gap-final)) !important;
    background-repeat: repeat-x, repeat-x !important;

    opacity: calc(0.20 + (var(--focus, 0) * 0.54)) !important;
    filter: none !important;
    transform: none !important;
    box-shadow: none !important;
    border: 0 !important;
    outline: 0 !important;
  }

  #featured-work .jbc-cinema-panel::after {
