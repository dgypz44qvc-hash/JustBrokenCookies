/* =========================================================
   SELECTED WORK CAROUSEL DOTS, TRUE FINAL OVERRIDE
   The previous dot fixes were being beaten by later carousel/frame rules.
   This disables the baked rose-frame dot overlay and draws clean,
   symmetrical top and bottom dot rows directly on each card.
   ========================================================= */

@media (min-width: 769px) {
  #featured-work .jbc-cinema-panel,
  #featured-work .jbc-cinema-panel.is-active,
  #featured-work .jbc-cinema-panel[style*="--focus"] {
    --jbc-film-dot-gap-real: 20px;
    position: absolute !important;
    overflow: hidden !important;
    border-radius: 44px !important;
  }

  /* Remove the old decorative overlay because its dots are baked into the image
     and cannot be repositioned independently. */
  #featured-work .jbc-cinema-panel::after {
    content: none !important;
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
    background-image: none !important;
  }

  /* Draw new symmetrical film dots, same distance from top and bottom. */
  #featured-work .jbc-cinema-panel::before,
  #featured-work .jbc-cinema-panel.is-active::before,
  #featured-work .jbc-cinema-panel[style*="--focus"]::before {
    content: "" !important;
    display: block !important;
    visibility: visible !important;
    opacity: calc(0.28 + (var(--focus, 0) * 0.58)) !important;

    position: absolute !important;
    inset: 0 !important;
    z-index: 60 !important;
    pointer-events: none !important;
    border-radius: inherit !important;

    background-image:
      radial-gradient(circle, rgba(240,230,218,0.62) 0 2.2px, transparent 2.65px),
      radial-gradient(circle, rgba(240,230,218,0.62) 0 2.2px, transparent 2.65px),
      linear-gradient(90deg, rgba(0,0,0,0.20), transparent 20%, transparent 80%, rgba(0,0,0,0.20));
    background-size:
      32px 8px,
      32px 8px,
      100% 100%;
    background-position:
      16px var(--jbc-film-dot-gap-real),
      16px calc(100% - var(--jbc-film-dot-gap-real)),
      center center;
    background-repeat:
      repeat-x,
      repeat-x,
      no-repeat;

    filter: none !important;
    transform: none !important;
    border: 0 !important;
    outline: 0 !important;
    box-shadow: none !important;
  }

  #featured-work .jbc-cinema-panel-meta,
  #featured-work .jbc-cinema-copy {
    position: relative !important;
    z-index: 80 !important;
  }
}

@media (max-width: 768px) {
  #featured-work .jbc-cinema-panel::before,
  #featured-work .jbc-cinema-panel::after {
    content: none !important;
    display: none !important;
  }
}
/* =========================================================
   SELECTED WORK FILM DOTS, HARD FINAL FIX
   Forces equal top/bottom dot spacing on the Crumbles of Creations
   carousel cards. Added to style.css for live site.
   ========================================================= */

@media (min-width: 769px) {
  #featured-work .jbc-cinema-panel {
    --jbc-film-dot-gap-final: 22px;
    position: absolute !important;
  }

  #featured-work .jbc-cinema-panel::before {
    content: "" !important;
    display: block !important;
    position: absolute !important;
    inset: 0 !important;
    z-index: 32 !important;
    pointer-events: none !important;
    border-radius: inherit !important;

    background-image:
      radial-gradient(circle, rgba(240,230,218,0.50) 0 2.4px, transparent 2.8px),
